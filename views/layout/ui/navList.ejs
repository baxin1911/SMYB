<% const items = [
    { 
        content: 'Productos', 
        href: '/products', 
        isActive: currentRoute === '/products'
    },
    { 
        content: 'Insumos', 
        href: '/supplies', 
        isActive: currentRoute === '/supplies' 
    },
    {
        content: 'Categorías',
        href: '/categories',
        isActive: currentRoute === '/categories'
    },
    {
        content: 'Proveedores',
        href: '/suppliers',
        isActive: currentRoute === '/suppliers'
    },
    { 
        content: 'Compras', 
        href: '/purchase-orders', 
        isActive: currentRoute === '/purchase-orders' 
    },
    { 
        content: 'Requisiciones', 
        href: '/purchase-requisitions', 
        isActive: currentRoute === '/purchase-requisitions' 
    },
    { 
        content: 'Devoluciones de requisición', 
        href: '/requisition-returns', 
        isActive: currentRoute === '/requisition-returns'
    },
    {
        content: 'Recepciones de compra',
        href: '/goods-receipts',
        isActive: currentRoute === '/goods-receipts'
    },
    {
        content: 'Devoluciones de compra',
        href: '/order-returns',
        isActive: currentRoute === '/order-returns'
    },
    {
        content: 'Salidas de almacén',
        href: '/goods-issues',
        isActive: currentRoute === '/goods-issues'
    },
    {
        content: 'Ajustes de inventario',
        href: '/inventory-adjustments',
        isActive: currentRoute === '/inventory-adjustments'
    },
    {
        content: 'Reportes',
        href: '/reports',
        isActive: currentRoute === '/reports'
    },
    {
        content: 'Usuarios',
        href: '/users',
        isActive: currentRoute === '/users'
    },
].map(item => ({
    ...item,
    class: `nav-link ${ item.isActive ? 'active' : ''}`
})); %>

<ul class="<%= listClass %>">
    <% items.forEach(item => { %>
        <li class="nav-item py-1">
            <a class="<%= item.class %>" href="<%= item.href %>" 
                <%= item.isActive ? 'aria-current="page"' : '' %>
            >
                <%- item.content %>
            </a>
        </li>
    <% }); %>
</ul>