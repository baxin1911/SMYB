<% button = {
    id: 'backBtn',
    class: 'btn btn-link',
    attrs: {
        'data-mdb-modal-init': '',
        'data-mdb-target': '#modal',
        'data-mdb-dismiss': 'modal'
    },
    content: 'Regresar'
}; %>

<div class="modal fade" id="modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
        
        <%- include('./header', { header: modal.header }) %>

        <div class="modal-body dark">
            <form id="<%= modal.form.id %>">
                <%- include('./outlineInputList', { inputs: modal.form.inputs }) %>
            </form>
        </div>

        <div class="modal-footer">
            <%- include('./button', { button }) %>
            <%- include('./submit', { button: modal.form.submitButton }) %>
        </div>

        </div>
    </div>
</div>